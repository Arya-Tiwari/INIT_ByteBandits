{
  "name": "aegis-app",
  "version": "1.0.0",
  "description": "AEGIS FinTech Hackathon MVP Root Launcher",
  "scripts": {
    "start": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev": "npm run start",
    "dev:backend": ".venv/bin/python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": ".venv/bin/python -m pytest backend/tests -q -o pythonpath=backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
